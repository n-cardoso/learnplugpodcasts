        <KEY NAME="episode_fk" TYPE="foreign" FIELDS="episodeid" REFTABLE="learnplugpodcasts_eps" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="episode_user_uix" UNIQUE="true" FIELDS="episodeid, userid"/>
        <INDEX NAME="userid_ix" UNIQUE="false" FIELDS="userid"/>
        <INDEX NAME="podcastid_ix" UNIQUE="false" FIELDS="podcastid"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="learnplugpodcasts_log" COMMENT="Publish and feed action log">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="podcastid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
