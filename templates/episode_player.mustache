{{!
@template mod_learnplugpodcasts/episode_player
@package mod_learnplugpodcasts
@copyright 2026 LearnPlug
@license http://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
Episode audio player snippet.
Example context (json):
{
"id": 1,
"audio": "https://example.com/audio.mp3",
"audiotype": "audio/mpeg",
"lastpositionsecs": 0,
"listenedpercent": 0,
"iscompleted": false
}
}}
{{#audio}}
<div class="lp-player-wrap">
<audio controls preload="metadata"
class="lp-audio"
data-episode-id="{{id}}"
data-last-position="{{lastpositionsecs}}">
<source src="{{audio}}" type="{{audiotype}}">
</audio>
<div class="lp-wave" data-region="lp-wave" aria-hidden="true">
<span></span><span></span><span></span><span></span><span></span>
</div>
<div class="lp-progress">
<span data-region="lp-progress-label">Listened: {{listenedpercent}}%</span>
{{#iscompleted}}
<span class="lp-completion-ok">{{#str}}completionstatus_complete, mod_learnplugpodcasts{{/str}}</span>
{{/iscompleted}}
</div>
</div>
{{/audio}}
{{^audio}}
<div class="lp-player-wrap">
    <audio controls preload="metadata" class="lp-audio" data-episode-id="{{id}}" data-last-position="0">
    </audio>
    <div class="lp-wave" data-region="lp-wave" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
    </div>
    <div class="lp-progress">
        <span data-region="lp-progress-label">Listened: 0%</span>
    </div>
</div>
{{/audio}}
