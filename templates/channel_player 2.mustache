{{!
@template mod_learnplugpodcasts/channel_player
Learner channel player with featured episode and playlist.
Example context (json):
{
"name": "AI Podcast",
"subtitle": "Learning series",
"authorname": "Teacher Name",
"intro": "<p>Podcast intro</p>",
"coverimage": "https://example.com/cover.jpg",
"searchplaceholder": "Search episodes",
"sortnewest": true,
"sortoldest": false,
"showsearch": true,
"showtranscripts": true,
"featuredepisode": {
"id": 1,
"title": "Episode title",
"episodeindex": 1,
"descriptionplain": "Episode description",
"duration": "12:18",
"audio": "https://example.com/audio.mp3",
"audiotype": "audio/mpeg",
"image": "https://example.com/episode.jpg",
"lastpositionsecs": 0,
"listenedpercent": 0,
"iscompleted": false,
"captiontrackurl": "",
"captiontracklang": "",
"captiontracksjson": "[]",
"hascaptiontracks": false,
"captiontracks": [],
"transcripttext": "",
"transcriptfileurl": "",
"externalurl": ""
},
"episodes": []
}
}}
<section class="lp-channel-player" data-region="lp-channel-player">
<div class="lp-channel-podcast-meta">
<div class="lp-channel-podcast-meta__image">
{{#coverimage}}<img src="{{coverimage}}" alt="{{name}}" class="lp-channel-podcast-cover">{{/coverimage}}
</div>
<div class="lp-channel-podcast-meta__text">
            <h1 class="lp-channel-podcast-title">{{name}}{{^name}}Podcast{{/name}}</h1>
{{#subtitle}}<p class="lp-channel-podcast-subtitle">{{subtitle}}</p>{{/subtitle}}
{{#authorname}}<p class="lp-channel-podcast-author">{{authorname}}</p>{{/authorname}}
<div class="lp-channel-podcast-description">{{{intro}}}</div>
</div>
</div>
<div class="lp-episodes-controls lp-channel-discovery">
{{#showsearch}}
<input type="search"
class="lp-search"
data-region="lp-channel-search"
placeholder="{{searchplaceholder}}">
{{/showsearch}}
<label class="lp-sort">
{{#str}}sortlabel, mod_learnplugpodcasts{{/str}}
<select data-region="lp-channel-sort">
<option value="newest" {{#sortnewest}}selected{{/sortnewest}}>
{{#str}}sort_newest, mod_learnplugpodcasts{{/str}}
</option>
<option value="oldest" {{#sortoldest}}selected{{/sortoldest}}>
{{#str}}sort_oldest, mod_learnplugpodcasts{{/str}}
</option>
</select>
</label>
</div>
<div class="lp-channel-player__hero">
{{#featuredepisode.image}}
<img src="{{featuredepisode.image}}" alt="{{featuredepisode.title}}" class="lp-channel-hero-image">
{{/featuredepisode.image}}
{{^featuredepisode.image}}
{{#coverimage}}
<img src="{{coverimage}}" alt="{{name}}" class="lp-channel-hero-image">
{{/coverimage}}
{{/featuredepisode.image}}
<div class="lp-channel-caption-overlay" data-region="lp-caption-overlay" aria-live="polite" hidden></div>
</div>
<div class="lp-channel-player__body">
        <h2 class="lp-channel-title"
            data-region="lp-featured-title">{{featuredepisode.title}}{{^featuredepisode.title}}Episode{{/featuredepisode.title}}</h2>
<p class="lp-channel-episode-label" data-region="lp-featured-meta">
Episode {{featuredepisode.episodeindex}}
</p>
<p class="lp-channel-description" data-region="lp-featured-description">
{{featuredepisode.descriptionplain}}
</p>
<p class="lp-external-link-row"
data-region="lp-featured-external-wrap"
{{^featuredepisode.externalurl}}hidden{{/featuredepisode.externalurl}}>
<a class="lp-external-link"
data-region="lp-featured-external-link"
href="{{featuredepisode.externalurl}}"
target="_blank"
rel="noopener noreferrer">
{{#str}}externalepisodelink, mod_learnplugpodcasts{{/str}}
</a>
</p>
{{#featuredepisode.audio}}
<div class="lp-player-wrap">
<div class="lp-channel-time-row">
<span data-region="lp-current-time">0:00</span>
<span data-region="lp-total-time">{{featuredepisode.duration}}</span>
</div>
<input class="lp-channel-seek"
data-region="lp-seekbar"
type="range"
min="0"
max="100"
value="0"
step="1"
aria-label="Seek">
<audio controls preload="metadata"
class="lp-audio lp-channel-audio"
data-episode-id="{{featuredepisode.id}}"
data-caption-url="{{featuredepisode.captiontrackurl}}"
data-caption-lang="{{featuredepisode.captiontracklang}}"
data-caption-tracks="{{featuredepisode.captiontracksjson}}"
data-last-position="{{featuredepisode.lastpositionsecs}}">
<source src="{{featuredepisode.audio}}" type="{{featuredepisode.audiotype}}">
</audio>
<div class="lp-channel-controls">
<div class="lp-channel-controls__left">
<button type="button" class="lp-icon-btn" data-action="seek-back" aria-label="Back 10 seconds">↺10</button>
<button type="button" class="lp-icon-btn lp-icon-btn--play" data-action="play-toggle" aria-label="Play or pause">▶</button>
<button type="button" class="lp-icon-btn" data-action="seek-forward" aria-label="Forward 10 seconds">10↻</button>
</div>
<div class="lp-channel-controls__right">
<label class="lp-caption-picker"
data-region="lp-caption-select-wrap"
{{^featuredepisode.hascaptiontracks}}hidden{{/featuredepisode.hascaptiontracks}}>
<span>{{#str}}captiontrackselect, mod_learnplugpodcasts{{/str}}</span>
<select class="lp-caption-picker__select" data-region="lp-caption-select">
<option value="">{{#str}}captiontrackoff, mod_learnplugpodcasts{{/str}}</option>
{{#featuredepisode.captiontracks}}
<option value="{{url}}" data-lang="{{lang}}" {{#isselected}}selected{{/isselected}}>
{{label}}
</option>
{{/featuredepisode.captiontracks}}
</select>
</label>
<button type="button" class="lp-icon-btn" data-action="speed-toggle" aria-label="Playback speed">×1</button>
<button type="button"
class="lp-icon-btn"
data-action="toggle-playlist"
aria-expanded="false"
aria-controls="lp-channel-playlist">
☰
</button>
</div>
</div>
<div class="lp-wave" data-region="lp-wave" aria-hidden="true">
<span></span><span></span><span></span><span></span><span></span>
</div>
<div class="lp-progress">
<span data-region="lp-progress-label">Listened: {{featuredepisode.listenedpercent}}%</span>
{{#featuredepisode.iscompleted}}
<span class="lp-completion-ok">{{#str}}completionstatus_complete, mod_learnplugpodcasts{{/str}}</span>
{{/featuredepisode.iscompleted}}
</div>
</div>
{{/featuredepisode.audio}}
{{#showtranscripts}}
<div class="lp-channel-transcript">
<details data-region="lp-transcript-details">
<summary>{{#str}}transcripttext, mod_learnplugpodcasts{{/str}}</summary>
<div data-region="lp-transcript-content">{{{featuredepisode.transcripttext}}}</div>
</details>
<a class="lp-transcript-link"
data-region="lp-transcript-link"
href="{{featuredepisode.transcriptfileurl}}"
{{^featuredepisode.transcriptfileurl}}style="display:none"{{/featuredepisode.transcriptfileurl}}>
{{#str}}downloadtranscript, mod_learnplugpodcasts{{/str}}
</a>
</div>
{{/showtranscripts}}
</div>
<div id="lp-channel-playlist" class="lp-channel-playlist" data-region="lp-playlist" hidden>
{{#episodes}}
<button type="button"
class="lp-playlist-item {{#isfeatured}}is-active{{/isfeatured}}"
data-action="select-episode"
data-episode-id="{{id}}"
data-audio="{{audio}}"
data-audiotype="{{audiotype}}"
data-title="{{title}}"
data-meta="Episode {{episodeindex}}"
data-description="{{descriptionplain}}"
data-publishtime="{{publishtimeunix}}"
data-image="{{displayimage}}"
data-last-position="{{lastpositionsecs}}"
data-duration-label="{{duration}}"
data-listened-percent="{{listenedpercent}}"
data-caption-url="{{captiontrackurl}}"
data-caption-lang="{{captiontracklang}}"
data-caption-tracks="{{captiontracksjson}}"
data-transcript-text="{{transcripttext}}"
data-transcript-fileurl="{{transcriptfileurl}}"
data-external-url="{{externalurl}}">
<span class="lp-playlist-item__thumb">
{{#image}}<img src="{{image}}" alt="{{title}}">{{/image}}
{{^image}}{{#coverimage}}<img src="{{coverimage}}" alt="{{title}}">{{/coverimage}}{{/image}}
</span>
<span class="lp-playlist-item__main">
<span class="lp-playlist-item__title">{{title}}</span>
<span class="lp-playlist-item__meta">Episode {{episodeindex}}</span>
</span>
<span class="lp-playlist-item__time">{{duration}}</span>
</button>
{{/episodes}}
</div>
</section>
